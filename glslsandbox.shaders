#ifdef GL_ES
precision mediump float;
#endif

uniform float time;
uniform vec2 resolution;

// vælg klan: 0=Green Classic, 1=MacLeod, 2=MacDonald, 3=Campbell
uniform int clanID;

float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}
float noise(vec2 p){vec2 i=floor(p);vec2 f=fract(p);
float a=hash(i);float b=hash(i+vec2(1,0));float c=hash(i+vec2(0,1));float d=hash(i+vec2(1,1));
vec2 u=f*f*(3.-2.*f);return mix(a,b,u.x)+(c-a)*u.y*(1.-u.x)+(d-b)*u.x*u.y;}

// vælg farvepalette for klan
void clanPalette(int id,out vec3 base,out vec3 stripe1,out vec3 stripe2,out vec3 accent){
    if(id==1){          // MacLeod – gul/sort med rød
        base=vec3(0.9,0.8,0.2);
        stripe1=vec3(0.05,0.05,0.05);
        stripe2=vec3(0.6,0.0,0.0);
        accent=vec3(0.9,0.1,0.1);
    }else if(id==2){    // MacDonald – rød/grøn/blå
        base=vec3(0.05,0.25,0.05);
        stripe1=vec3(0.6,0.05,0.05);
        stripe2=vec3(0.05,0.1,0.4);
        accent=vec3(0.0,0.0,0.0);
    }else if(id==3){    // Campbell – mørk blågrøn
        base=vec3(0.02,0.15,0.1);
        stripe1=vec3(0.0,0.3,0.25);
        stripe2=vec3(0.05,0.05,0.25);
        accent=vec3(0.02);
    }else{              // Default Green Classic
        base=vec3(0.0,0.25,0.08);
        stripe1=vec3(0.6,0.0,0.0);
        stripe2=vec3(0.1,0.1,0.5);
        accent=vec3(0.02);
    }
}

void main(void){
    vec2 uv0=gl_FragCoord.xy/resolution.xy;
    uv0.x*=resolution.x/resolution.y;
    vec2 uv=uv0*10.0;
    uv.y+=sin(uv.x*2.3+time*1.6)*0.06;
    uv.x+=sin(uv.y*3.1+time*1.9)*0.03;

    float sx=abs(fract(uv.x)-0.5);
    float sy=abs(fract(uv.y)-0.5);
    float thickX=smoothstep(0.42,0.46,sx);
    float thickY=smoothstep(0.42,0.46,sy);
    float thinX=smoothstep(0.34,0.37,sx);
    float thinY=smoothstep(0.34,0.37,sy);

    vec3 base,stripe1,stripe2,accent;
    clanPalette(clanID,base,stripe1,stripe2,accent);

    vec3 color=base;
    color=mix(color,stripe1,thickX);
    color=mix(color,stripe2,thickY);
    color=mix(color,accent,thinX*thinY);

    // vævning og lys
    float weave=sin(uv.x*80.0)*sin(uv.y*80.0);
    float weaveB=0.5+0.5*weave;
    float texn=noise(uv*12.0)*0.08;
    vec3 light=vec3(0.3+0.6*weaveB+texn);
    color*=light;

    // Scotland saltire vævet ind
    vec2 p=uv0-vec2(0.5);
    float w=0.08;
    vec2 n1=normalize(vec2(1.0,1.0));
    vec2 n2=normalize(vec2(1.0,-1.0));
    float band1=1.0-smoothstep(w-0.02,w+0.02,abs(dot(p,n1)));
    float band2=1.0-smoothstep(w-0.02,w+0.02,abs(dot(p,n2)));
    float saltireMask=clamp(band1+band2,0.0,1.0);
    vec3 saltireColor=vec3(0.95);
    float weaveLocal=0.5+0.5*sin((uv.x+uv.y)*60.0+time*2.0);
    float wovenAlpha=saltireMask*(0.6+0.4*weaveLocal);
    color=mix(color,saltireColor*light,wovenAlpha);

    // let vignette
    float v=smoothstep(0.9,0.4,length(uv0-0.5));
    color*=v;

    gl_FragColor=vec4(color,1.0);
}
